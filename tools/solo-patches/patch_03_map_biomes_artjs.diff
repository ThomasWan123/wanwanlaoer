+    _terrainNoise(ctx, W, H, theme) {
+        // low-contrast dots + blobs, avoids interfering with the path
+        ctx.save();
+        for (let i = 0; i < 70; i++) {
+            const x = (i * 137) % W, y = (i * 73 + 37) % H;
+            ctx.fillStyle = "rgba(80,50,20,.18)";
+            ctx.beginPath();
+            ctx.arc(x, y, 14 + (i % 5) * 4, 0, Math.PI * 2);
+            ctx.fill();
+        }
+        for (let i = 0; i < 46; i++) {
+            const x = (i * 211 + 60) % W, y = (i * 97 + 17) % H;
+            ctx.fillStyle = "rgba(60,90,40,.14)";
+            ctx.beginPath();
+            ctx.arc(x, y, 5 + (i % 3) * 2, 0, Math.PI * 2);
+            ctx.fill();
+        }
+        ctx.restore();
+    },
+
+    _drawHills(ctx, W, H, theme) {
+        ctx.save();
+        // big soft hill shadows
+        for (let i = 0; i < 10; i++) {
+            const x = ((i * 193) % W) + 40;
+            const y = ((i * 121) % H) + 30;
+            const rx = 120 + (i % 3) * 60;
+            const ry = 55 + (i % 4) * 18;
+            ctx.fillStyle = "rgba(0,0,0,.10)";
+            ctx.beginPath();
+            ctx.ellipse(x, y, rx, ry, 0, 0, Math.PI * 2);
+            ctx.fill();
+            ctx.fillStyle = "rgba(120,90,50,.08)";
+            ctx.beginPath();
+            ctx.ellipse(x - 14, y - 8, rx * 0.72, ry * 0.68, 0, 0, Math.PI * 2);
+            ctx.fill();
+        }
+        // small rock clusters
+        for (let i = 0; i < 28; i++) {
+            const x = (i * 79 + 30) % W;
+            const y = (i * 131 + 50) % H;
+            ctx.fillStyle = "rgba(40,40,40,.20)";
+            ctx.beginPath();
+            ctx.arc(x, y, 6 + (i % 4) * 2, 0, Math.PI * 2);
+            ctx.fill();
+        }
+        ctx.restore();
+    },
+
+    _drawRiver(ctx, W, H, theme) {
+        ctx.save();
+        // a diagonal band (kept subtle)
+        const grad = ctx.createLinearGradient(0, H * 0.2, W, H * 0.8);
+        grad.addColorStop(0, "rgba(40,120,180,.0)");
+        grad.addColorStop(0.35, "rgba(40,120,180,.14)");
+        grad.addColorStop(0.65, "rgba(80,170,255,.18)");
+        grad.addColorStop(1, "rgba(40,120,180,.0)");
+        ctx.fillStyle = grad;
+        ctx.beginPath();
+        ctx.moveTo(0, H * 0.25);
+        ctx.lineTo(W, H * 0.55);
+        ctx.lineTo(W, H * 0.70);
+        ctx.lineTo(0, H * 0.40);
+        ctx.closePath();
+        ctx.fill();
+
+        // ripples
+        ctx.strokeStyle = "rgba(200,240,255,.12)";
+        ctx.lineWidth = 1;
+        for (let i = 0; i < 22; i++) {
+            const x = (i * 49) % W;
+            const y = H * 0.33 + ((i * 37) % 120);
+            ctx.beginPath();
+            ctx.ellipse(x, y, 18, 5, 0.2, 0, Math.PI * 2);
+            ctx.stroke();
+        }
+        ctx.restore();
+    },
+
+    _drawSnowPatches(ctx, W, H, theme) {
+        ctx.save();
+        for (let i = 0; i < 16; i++) {
+            const x = (i * 113 + 40) % W;
+            const y = (i * 91 + 30) % H;
+            ctx.fillStyle = "rgba(235,245,255,.16)";
+            ctx.beginPath();
+            ctx.ellipse(x, y, 60 + (i % 4) * 22, 22 + (i % 3) * 10, 0.2, 0, Math.PI * 2);
+            ctx.fill();
+        }
+        ctx.restore();
+    },
+
+    _drawScorch(ctx, W, H, theme) {
+        ctx.save();
+        for (let i = 0; i < 18; i++) {
+            const x = (i * 151 + 70) % W;
+            const y = (i * 83 + 40) % H;
+            ctx.fillStyle = "rgba(0,0,0,.16)";
+            ctx.beginPath();
+            ctx.ellipse(x, y, 50 + (i % 4) * 18, 18 + (i % 3) * 8, (i % 7) * 0.2, 0, Math.PI * 2);
+            ctx.fill();
+            ctx.fillStyle = "rgba(255,120,40,.05)";
+            ctx.beginPath();
+            ctx.ellipse(x - 8, y - 4, 22, 8, 0.15, 0, Math.PI * 2);
+            ctx.fill();
+        }
+        ctx.restore();
+    },
+
+    _drawCityGate(ctx, x, y, theme) {
+        // Slightly larger than original, but still compact and readable
+        ctx.save();
+        // drop shadow
+        ctx.fillStyle = "rgba(0,0,0,.45)";
+        ctx.fillRect(x - 36, y - 20, 76, 60);
+
+        // main wall block
+        ctx.fillStyle = theme.gateStone;
+        ctx.fillRect(x - 38, y - 30, 76, 60);
+
+        // top cap
+        ctx.fillStyle = theme.gateShadow;
+        ctx.fillRect(x - 38, y - 30, 76, 10);
+
+        // crenellations
+        ctx.fillStyle = theme.gateStone;
+        for (let i = -3; i <= 2; i++) ctx.fillRect(x + i * 12 + 4, y - 42, 8, 12);
+
+        // arch opening
+        ctx.fillStyle = "#0b0705";
+        ctx.beginPath();
+        ctx.moveTo(x - 12, y + 28);
+        ctx.lineTo(x - 12, y - 2);
+        ctx.quadraticCurveTo(x, y - 18, x + 12, y - 2);
+        ctx.lineTo(x + 12, y + 28);
+        ctx.closePath();
+        ctx.fill();
+
+        // inner glow (subtle)
+        const g = ctx.createRadialGradient(x, y + 10, 2, x, y + 10, 22);
+        g.addColorStop(0, "rgba(255,200,120,.10)");
+        g.addColorStop(1, "rgba(255,200,120,0)");
+        ctx.fillStyle = g;
+        ctx.beginPath();
+        ctx.arc(x, y + 10, 24, 0, Math.PI * 2);
+        ctx.fill();
+
+        // label
+        ctx.fillStyle = theme.textOnMap;
+        ctx.font = "bold 12px serif";
+        ctx.textAlign = "center";
+        ctx.fillText("皇", x, y + 2);
+        ctx.fillText("城", x, y + 18);
+
+        // torches
+        ctx.fillStyle = "rgba(255,140,60,.9)";
+        ctx.beginPath(); ctx.arc(x - 26, y - 6, 3, 0, Math.PI * 2); ctx.fill();
+        ctx.beginPath(); ctx.arc(x + 26, y - 6, 3, 0, Math.PI * 2); ctx.fill();
+        ctx.restore();
+    },
